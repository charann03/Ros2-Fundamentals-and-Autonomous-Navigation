<?xml version="1.0" ?>
<robot name="tortoisebot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<link name="base_link">
    <visual name="">
        <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0"/>
        <geometry>
            <box size="0.6 0.3 0.3"/>
        </geometry>
        <material name="">
            <color rgba="0 0.6 0.0 1.0"/>

        </material>
    </visual>
    <collision>
        <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0"/>
        <geometry>
            <box size="0.6 0.3 0.3"/>
        </geometry>
    </collision>

    <xacro:box_inertia m="5.0" l="0.6" w="0.3" h="0.3"
                            xyz="0 0 0.15" rpy="0 0 0"/> 
</link>

<link name="front_caster">

    <visual name="">
        <origin xyz="0.05 0.0 0.15" rpy="0.0 0.0 0.0"/>
        <geometry>
            <box size="0.1 0.1 0.3"/>
        </geometry>
        <material name="">
            <color rgba="1.0 0.0 0.0 1.0"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0.05 0.0 0.15" rpy="0.0 0.0 0.0"/>
        <geometry>
            <box size="0.1 0.1 0.3"/>
        </geometry>
    </collision>

    <xacro:box_inertia m="5.0" l="0.1" w="0.1" h="0.3"
                            xyz="0 0 0.15" rpy="0 0 0"/> 
</link>
<joint name="front_castor_joint" type="continuous">
    <origin xyz="0.25 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="front_caster"/>
    <axis xyz="0 0 1"/>
</joint>

<link name="front_wheel">

    <visual name="">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <cylinder radius="0.035" length="0.05"/>
        </geometry>
        <material name="">
            <color rgba="1.0 1.0 1.0 1.0"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <cylinder radius="0.035" length="0.05"/>
        </geometry>
    </collision>

    <xacro:wheel_inertia m="1.0" r="0.035" l="0.05" 
                                 xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
</link>

<joint name="front_wheel_joint" type="continuous">
    <origin xyz="0.1 0 0" rpy="${pi/2.0} 0.0 0.0"/>
    <parent link="front_caster"/>
    <child link="front_wheel"/>
    <axis xyz="0.0 0.0 -1"/>
</joint>
<link name="right_wheel">

    <visual name="">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <cylinder radius="0.035" length="0.05"/>
        </geometry>
        <material name="">
            <color rgba="1.0 1.0 1.0 1.0"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <cylinder radius="0.035" length="0.05"/>
        </geometry>
    </collision>

    <xacro:wheel_inertia m="1.0" r="0.035" l="0.05" 
                                 xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>

</link>
<joint name="right_wheel_joint" type="continuous">
    <origin xyz="-0.2 -0.175 0.0" rpy="${pi/2.0} 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <axis xyz="0 0 -1"/>
</joint>

<link name="left_wheel">


    <visual name="">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <cylinder radius="0.035" length="0.05"/>
        </geometry>
        <material name="">
            <color rgba="1.0 1.0 1.0 1.0"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <cylinder radius="0.035" length="0.05"/>
        </geometry>
    </collision>
    <xacro:wheel_inertia m="1.0" r="0.035" l="0.05" 
                                 xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>

</link>

<joint name="left_wheel_joint" type="continuous">
    <origin xyz="-0.2 0.175 0.0" rpy="${pi/2.0} 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <axis xyz="0 0 -1"/>
</joint>

<link name="base_footprint">
    
</link>
<joint name="base_footprint_joint" type="fixed">
    <origin xyz="0.0 0.0 0.035" rpy="0.0 0.0 0.0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
</joint>
</robot>