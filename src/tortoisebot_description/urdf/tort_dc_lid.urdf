<?xml version="1.0"?>
<robot name="tortoisebot">

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.6 0.3 0.3"/>
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.6 0.3 0.3"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.015" iyy="0.0375" izz="0.0375" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  

  <link name="front_caster">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.15"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00083" iyy="0.00083" izz="0.000167" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="front_caster_joint" type="continuous">
    <axis xyz="0 0 1"/>
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin rpy="0 0 0" xyz="0.3 0 -0.075"/>
  </joint>

  <link name="front_wheel">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.035"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.05" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="5.1458e-5" iyy="5.1458e-5" izz="6.125e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="front_wheel_joint" type="continuous">
    <axis xyz="0 0 1"/>
    <parent link="front_caster"/>
    <child link="front_wheel"/>
    <origin rpy="-1.5708 0 0" xyz="0.05 0 -.075"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.035"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.05" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="5.1458e-5" iyy="5.1458e-5" izz="6.125e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <axis xyz="0 0 1"/>
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin rpy="-1.5708 0 0" xyz="-0.2825 -0.125 -.15"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.035"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.05" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="5.1458e-5" iyy="5.1458e-5" izz="6.125e-5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <axis xyz="0 0 1"/>
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin rpy="-1.5708 0 0" xyz="-0.2825 0.125 -.15"/>
  </joint>
  <gazebo>
    <plugin name="gazebo_ros_joint_state_publisher"
        filename="libgazebo_ros_joint_state_publisher.so">


      <!-- Update rate in Hertz -->
      <update_rate>50</update_rate>

      <!-- Name of joints in the model whose states will be published. -->
      <joint_name>front_caster_joint</joint_name>
      <joint_name>front_wheel_joint</joint_name>

    </plugin>
    </gazebo>

    <gazebo>

    <plugin name="gazebo_ros_diff_drive" filename="libgazebo_ros_diff_drive.so">

        <ros>

        <!-- Add a namespace -->
        <!-- <namespace>/test</namespace> -->

        </ros>

        <!-- Update rate in Hz "50" times per second-->
        <update_rate>50</update_rate>

        <!-- wheels -->
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>

        <!-- kinematics -->
        <!--wheel seperation = base_width + 1/2 length of w1 + 1/2 of length of wheel2-->
        <wheel_separation>0.35</wheel_separation>
        <!--wheel diameter 2*wheel radius   -->
        <wheel_diameter>0.07</wheel_diameter>

        <!-- limits -->
        <!--<max_wheel_torque>20</max_wheel_torque>
        <max_wheel_acceleration>1.0</max_wheel_acceleration>
        -->
        <!-- input -->
        <!--by default for differential drive it is cmd_vel topic so this can be romoved-->
        <!--<command_topic>cmd_vel</command_topic> -->

        <!-- output -->
        <publish_odom>true</publish_odom> <!--  keeps track of where the robot from the start point ie.. distance traversed by the robot since the start point-->
        <publish_odom_tf>true</publish_odom_tf> <!--keeps robot position data from the starting point-->
        <publish_wheel_tf>true</publish_wheel_tf>

        <odometry_topic>odom</odometry_topic>
        <odometry_frame>odom</odometry_frame>
        <!--chassis frame must be base_footprint frame because that it what holds up the entire robot up from ground-->
        <robot_base_frame>base_link</robot_base_frame>

    </plugin>
    </gazebo>


  <link name="lidar_link">
    <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="0.1"/>
        <inertia 
    ixx="0.0000925"
    ixy="0.0"
    ixz="0.0"
    iyy="0.0000925"
    iyz="0.0"
    izz="0.000125"/>
    </inertial>
    <visual>
        <origin xyz="0.0 0.0 -0.03" rpy="0.0 0.0 0.0"/>
        <geometry>
            <cylinder radius="0.05" length="0.05"/>
        </geometry>
        <material name="">
            <color rgba="0.0 0.0 0.0 1.0"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0.0 0.0 -0.03" rpy="0.0 0.0 0.0"/>
        <geometry>
            <cylinder radius="0.05" length="0.06"/>
        </geometry>
    </collision>
  </link>

  <joint name="lidar_base_joint" type="fixed">
    <origin xyz="0.0 0.0 0.18" rpy="0.0 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <axis xyz="0.0 0.0 1.0"/>

  </joint>


    <gazebo reference="lidar_link">
        <material>Gazebo/Red</material>

        <sensor name="laser" type="ray">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <min_angle>-3.14</min_angle>
                        <max_angle>3.14</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.3</min>
                    <max>12</max>
                </range>
            </ray>
            <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <argument>~/out:=scan</argument>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>lidar_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>  
<!-- ================= CAMERA LINK ================= -->

<link name="camera_link">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.1"/>
    <inertia 
      ixx="0.00010417"
      ixy="0.0"
      ixz="0.0"
      iyy="0.00004167"
      iyz="0.0"
      izz="0.00010417"/>
  </inertial>

  <visual>
    <origin xyz="0.0 0 0.0" rpy="0 0 0"/>
    <geometry>
      <box size="0.05 0.1 0.05"/>
    </geometry>
    <material name="black">
      <color rgba="0 0 0 1"/>
    </material>
  </visual>

  <collision>
    <origin xyz="0.0 0 0.025" rpy="0 0 0"/>
    <geometry>
      <box size="0.05 0.1 0.05"/>
    </geometry>
  </collision>
</link>



<joint name="camera_base_joint" type="fixed">
  <origin xyz="0.325 0 0.125" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="camera_link"/>
</joint>

<!-- camera coordinate system transform for vision-->

<link name="camera_optical_link"/>

<joint name="camera_optical_joint" type="fixed">
  <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
  <parent link="camera_link"/>
  <child link="camera_optical_link"/>
</joint>



<!-- depth camera gazebo plugin-->
    <gazebo reference="camera_link">
        <material>Gazebo/Red</material>

        <sensor name="camera" type="depth">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <camera>
            <!--fov in radians(refer with actual camera)-->
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <!--depth cam in bgr format-->
                    <format>B8G8R8</format>
                </image>
                <clip>
                    <near>0.02</near>
                    <!--8.0 metres far-->
                    <far>8.0</far>
                </clip>
            </camera>
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">

                <frame_name>camera_optical_link</frame_name>
                <!--two extra params in the plugin-->
                <min_depth>0.1</min_depth>
                <max_depth>100.0</max_depth>
            </plugin>
        </sensor>
    </gazebo>  


</robot>