#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from std_msgs.msg import Int64MultiArray, Bool
# from std_msgs.msg import Bool
from sensor_msgs.msg import Image
from sensor_msgs_py import point_cloud2
from sensor_msgs.msg import PointCloud2
from cv_bridge import CvBridge , CvBridgeError
import cv2
import numpy as np
from tf2_ros import TransformBroadcaster
from geometry_msgs.msg import TransformStamped

# from sklearn.cluster import DBSCAN
class CameraToWorld(Node):

    def __init__(self):

        super().__init__("camera_to_world")
        self.tf_broadcaster = TransformBroadcaster(self)

        # self.cx = None
        # self.cy = None
        self.object_detected = False   # "0" denotes no object detected "1" denotes onject_detected
        self.annotated_image = None
        self.bounding_box_array = []
        self.bridge_object = CvBridge()
        self.x = None
        self.y = None
        self.z = None


        # self.sub_coord = self.create_subscription(
        #     Image,
        #     "/detected_object_image",
        #     self.image_callback,
        #     1
        # )
        self.sub_coord = self.create_subscription(
            Image,
            "/camera/image_raw",
            self.image_callback,
            1
        )

        self.cam_pts = self.create_subscription(
            PointCloud2,
            "/camera/points",
            self.point_cloud_callback,
            1
        )

        self.object_detected_bool = self.create_subscription(
            Bool,
            "/bool_object_detection",
            self.object_detected_callback,
            1
        )

        self.bounding_box_sub = self.create_subscription(
            Int64MultiArray,
            "/bounding_box_array",
            self.bounding_box_callback,
            1
            )

    def object_detected_callback(self, msg):
        self.object_detected = msg.data   
        # print(self.object_detected)

    def image_callback(self, data: Image):
        try:
            #converting sensor_msgs/image to cv2 image
            cv_image = self.bridge_object.imgmsg_to_cv2(
                data,
                desired_encoding="bgr8"
            )
            # to publish cv2 images into ros
            # crop_msg = self.bridge_object.cv2_to_imgmsg(
            #     crop,
            #     encoding="bgr8"
            # )


        except CvBridgeError as e:
            self.get_logger().error(str(e))
            return
        self.annotated_image = cv_image

    def bounding_box_callback(self, msg: Int64MultiArray):
        self.bounding_box_array = msg.data
        # print(self.bounding_box_array)

    def point_cloud_callback(self, msg: PointCloud2):
        # pass
        if not self.object_detected:
            return

        if self.annotated_image is None:
            return

        if len(self.bounding_box_array) != 4:
            return

        # x1, y1, x2, y2 = self.bounding_box_array
        x1, y1, x2, y2 = self.bounding_box_array
        
        detected_crop_image = self.annotated_image[y1: y2, x1: x2] # this is the actual syntax of cropping images [rows, columns]
        #apply canny edge detection and merge with annotated frame
        gray_crop_image = cv2.cvtColor(detected_crop_image, cv2.COLOR_BGR2GRAY)
        edges = cv2.Canny(detected_crop_image, 150, 150)
        cv2.imshow("edges",edges)
        # edges_bgr = cv2.cvtColor(edges, cv2.COLOR_GRAY2BGR)

        contours, _ = cv2.findContours(
        edges,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
        )
        if len(contours) == 0:
            self.get_logger().warn("No contours found")
            return
        #choose the largest contour
        largest_contour = max(contours, key=cv2.contourArea)
        # Mask the largest_contour
        mask = np.zeros(edges.shape, dtype=np.uint8)
        cv2.drawContours(
            mask,
            [largest_contour],
            -1,
            255,
            thickness=cv2.FILLED
        )
        cv2.imshow("mask", mask)
        # obtaining depth coordinates from pixel coordinates(ImageSS)

        points = point_cloud2.read_points_numpy(
            msg,
            field_names=["x","y","z"],
            skip_nans=False
        )

        points = points.reshape(msg.height, msg.width, 3)
        # find the object pixels
        ys, xs = np.where(mask>0)
        # croped image pixel coordinates to image coordinates

        image_x = xs + x1
        image_y = ys + y1
        # obtain depth coordinates
        depth_coords = points[image_y, image_x]
        #remove invalid points
        valid = np.isfinite(depth_coords).all(axis=1)
        depth_coords = depth_coords[valid]

        if depth_coords.shape[0] == 0:
            self.get_logger().warn("No valid depth points")
            return
        # compute median of point values iN
        # Find the nearest depth
        min_z = np.min(depth_coords[:, 2])

        # Keep points within 1 cm of the nearest depth
        threshold = 0.01  # meters

        nearest_points = depth_coords[
            np.abs(depth_coords[:, 2] - min_z) < threshold
        ]

        # Compute median of only the nearest points
        centroid = np.median(nearest_points, axis=0)

        x = centroid[0]
        y = centroid[1]
        z = centroid[2]

        print(f"Min Z       : {min_z:.3f}")
        print(f"Filtered Z  : {z:.3f}")
        print(f"Centroid    : ({x:.3f}, {y:.3f}, {z:.3f})")
        self.publish_transform(msg.header.frame_id, x, y, z)
        cv2.waitKey(1)

    def publish_transform(self, header_frame_id, x, y, z):
        t = TransformStamped()
        t.header.stamp = self.get_clock().now().to_msg()
        t.header.frame_id = header_frame_id
        t.child_frame_id = "detected_object_frame"
        t.transform.translation.x = float(x)
        t.transform.translation.y = float(y)
        t.transform.translation.z = float(z)
        t.transform.rotation.x = 0.0
        t.transform.rotation.y = 0.0
        t.transform.rotation.z = 0.0
        t.transform.rotation.w = 1.0
        self.tf_broadcaster.sendTransform(t)




def main(args = None):
    rclpy.init(args= args)
    node = CameraToWorld()         #Modify  node_class_name heRE
    rclpy.spin(node)
    rclpy.shutdown()


if __name__ == "__main__":
    main()





