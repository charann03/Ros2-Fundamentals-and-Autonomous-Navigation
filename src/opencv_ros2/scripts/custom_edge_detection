#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
import cv2
import numpy as np
from sensor_msgs.msg import Image
from cv_bridge import CvBridge, CvBridgeError


class Custom_Edge_Detection(Node):

    def __init__(self):
        super().__init__("Custom_Edge_Detection_Node")
        self.image_sub = self.create_subscription(Image,"/camera/image_raw",  self.camera_callback, 10)
        self.bridge_object = CvBridge()

    def camera_callback(self, data: Image):
        try:
            cv_image = self.bridge_object.imgmsg_to_cv2(data, desired_encoding ="bgr8")
        except CvBridgeError as e:
            print(e)
    
        # convert image from RGB to HSV(hsv is how human eye interprets colors)

        """
        RGB is a hardware-native color space that is fast to process and widely used
        for image display and general-purpose computer vision tasks.

        HSV represents colors in terms of Hue, Saturation, and Value, making it more
        aligned with human color perception. It is particularly useful for color-based
        segmentation, object detection, and tracking applications, especially under
        varying lighting conditions.
        """
        hsv_image = cv2.cvtColor(cv_image, cv2.COLOR_BGR2HSV)
        # red has lower hue values and higher hue values
        lower_red1 = np.array([0, 120, 70])
        upper_red1 = np.array([10, 255, 255])
        lower_red2 = np.array([170, 120, 70])
        upper_red2 = np.array([180, 255, 255])

        mask1 = cv2.inRange(hsv_image, lower_red1, upper_red1)
        mask2 = cv2.inRange(hsv_image, lower_red2, upper_red2)

        #grayscale image
        red_mask = mask1 + mask2
        # Use bitwise AND to extract the blue color from the original image
        result = cv2.bitwise_and(cv_image, cv_image, mask=red_mask)

        cv2.imshow('Original', cv_image)
        cv2.imshow('Mask on color', red_mask)
        cv2.imshow('Red', result)
        gray = cv2.cvtColor(result, cv2.COLOR_BGR2GRAY)
        cv2.imshow("gray", gray)
        ret, thresh = cv2.threshold(gray, 230, 255, cv2.THRESH_BINARY_INV) #(graycale_image, threshold_value, maximum_value, operation_type)
        cv2.imshow("binary_image", thresh)
        cv2.waitKey(1)






def main(args = None):
    rclpy.init(args= args)
    node = Custom_Edge_Detection()         #Modify  node_class_name heRE
    rclpy.spin(node)
    rclpy.shutdown()
    cv2.destroyAllWindows()



if __name__ == "__main__":
    main()