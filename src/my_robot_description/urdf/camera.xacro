<?xml version="1.0"?>
<!-- XML declaration. Must be the first line of the file -->

<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
<!-- Root element of URDF/Xacro
     name defines robot model name
     xmlns:xacro enables xacro features like properties and math -->

    <!-- Camera dimension properties -->

    <xacro:property name="camera_length" value="0.01"/>
    <!-- Defines camera length in meters -->

    <xacro:property name="camera_width" value="0.1"/>
    <!-- Defines camera width -->

    <xacro:property name="camera_height" value="0.06"/>
    <!-- Defines camera height -->


    <!-- Camera rigid body link -->

    <link name="camera_link">
    <!-- Link represents a physical rigid body -->

        <visual>
        <!-- Visual defines appearance in RViz -->

            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}"/>
                <!-- Box geometry using xacro variables -->
            </geometry>

            <material name="gray"/>
            <!-- Applies previously defined gray material -->

        </visual>

        <collision>
        <!-- Collision defines physical contact shape for simulation -->

            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}"/>
                <!-- Usually same as visual geometry -->
            </geometry>

        </collision>

        <xacro:box_inertia 
            m="0.1"
            l="${camera_length}"
            w="${camera_width}"
            h="${camera_height}"
            xyz="0 0 0"
            rpy="0 0 0"/>
        <!-- Calls inertia macro to insert inertial properties
             m is mass
             l w h are box dimensions
             xyz and rpy define inertial frame origin -->

    </link>
    <link name="camera_link_optical"> <!--opeNCV camera link-->
    </link>


    <!-- Fixed joint attaching camera to base -->

    <joint name="base_camera_joint" type="fixed">
    <!-- Fixed joint means no motion between parent and child -->

        <parent link="base_link"/>
        <!-- Parent link must exist in main robot -->

        <child link="camera_link"/>
        <!-- Child link defined above -->

        <origin xyz="${(base_length + camera_length)/2.0} 0 ${base_height/2.0}" rpy="0 0 0"/>
        <!-- Position of camera relative to base_link
             xyz in meters
             rpy in radians
             Uses xacro math expressions -->

    </joint>
    <!--rviz and opencv convention must ADD-->
      <!-- generate an optical frame 
      http://www.ros.org/reps/rep-0103.html#suffix-frames
      so that ros and opencv can operate on the camera frame correctly 
      -->
    <joint name="camera_optical_joint" type="fixed">
    <!-- these values have to be these values otherwise the gazebo camera
        image won't be aligned properly with the frame it is supposedly
        originating from -->
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/> <!--this makes the zaxis perpendicular to the camera lens surface-->
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
    </joint>



    <!-- Gazebo specific properties for camera -->

    <gazebo reference="camera_link">
    <!-- Applies Gazebo settings to camera_link -->

        <material>Gazebo/Grey</material>
        <!-- Sets Gazebo rendering material -->

        <sensor name="camera_sensor" type="camera">
        <!-- Defines a Gazebo camera sensor -->

            <pose>0 0 0 0 0 0</pose>
            <!-- Sensor position relative to camera_link
                 Format is x y z roll pitch yaw -->

            <visualize>false</visualize>
            <!-- Shows camera visualization in Gazebo -->

            <update_rate>10.0</update_rate>
            <!-- Sensor update frequency in Hz -->

            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <!-- ROS plugin that connects Gazebo camera to ROS topics -->

                <frame_name>camera_link_optical</frame_name>
                <!-- TF frame name used by ROS note= if to use opencv then use camera link optical frame-->

            </plugin>

        </sensor>

    </gazebo>

</robot>
