<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ================= MATERIALS ================= -->

    <material name="green">
        <color rgba="0 0.5 0 1"/>
    </material>

    <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
    </material>


    <!--    inertia syntax  
    <xacro:macro name="box_inertia" params="m l w h xyz rpy">

        <link>
        <inertial>
            <origin/>
            <mass/>
            <inertia/>
        </inertial>
        </link>

    
    -->

    <!-- ================= BOX INERTIA ================= -->
    <!-- m = mass
         l = length (x)
         w = width  (y)
         h = height (z)
         xyz = origin
         rpy = rotation
    -->

    <xacro:macro name="box_inertia" params="m l w h xyz rpy">
        <inertial>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <mass value="${m}"/>

            <inertia
                ixx="${(m/12.0)*(w*w + h*h)}"
                ixy="0.0"
                ixz="0.0"
                iyy="${(m/12.0)*(l*l + h*h)}"
                iyz="0.0"
                izz="${(m/12.0)*(l*l + w*w)}"/>
        </inertial>
    </xacro:macro>


    <!-- ================= CYLINDER (WHEEL) INERTIA ================= -->
    <!-- r = radius
         l = length (along cylinder axis)
    -->

    <xacro:macro name="wheel_inertia" params="m r l xyz rpy">
        <inertial>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <mass value="${m}"/>

            <inertia
                ixx="${(m/12.0)*(3*r*r + l*l)}"
                ixy="0.0"
                ixz="0.0"
                iyy="${(m/12.0)*(3*r*r + l*l)}"
                iyz="0.0"
                izz="${(m/2.0)*(r*r)}"/>
        </inertial>
    </xacro:macro>


    <!-- ================= SPHERE (CASTER) INERTIA ================= -->

    <xacro:macro name="castor_inertia" params="m r xyz rpy">
        <inertial>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <mass value="${m}"/>

            <inertia
                ixx="${(2.0/5.0)*m*r*r}"
                ixy="0.0"
                ixz="0.0"
                iyy="${(2.0/5.0)*m*r*r}"
                iyz="0.0"
                izz="${(2.0/5.0)*m*r*r}"/>
        </inertial>
    </xacro:macro>

</robot>
